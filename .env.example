# 量化交易预警系统 - 环境变量配置模版
# 复制本文件为 .env 即可生效，无需修改 Python 源码

# 微信推送 Token (PushPlus 推送加)
PUSHPLUS_TOKEN=f82973cf1342485fa7114d4f888fbbe2

# 微信推送总开关 (true / false)
NOTIFY_ENABLED=true

# 推送通道选择 (pushplus / serverchan / wecom)
NOTIFY_CHANNEL=pushplus

# Server酱 SendKey (可选)
SERVERCHAN_KEY=

# 企业微信群机器人 Webhook Key (可选)
WECOM_WEBHOOK_KEY=
